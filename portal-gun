local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local blue, orange
local nextBlue = true
local armed = true

local ENTER_RADIUS = 4.5
local REARM_RADIUS = 6.5
local EXIT_OFFSET = 5.5

local function makePortal(color, name)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = Vector3.new(5, 7, 0.4)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Transparency = 0.15
    return p
end

local function placePortal(isBlue)
    local char = player.Character
    if not char then return end

    local cam = workspace.CurrentCamera
    local ray = cam:ScreenPointToRay(mouse.X, mouse.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }

    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if not result then return end

    local pos, normal = result.Position, result.Normal
    local portal
    if isBlue then
        if blue then blue:Destroy() end
        blue = makePortal(Color3.fromRGB(0, 140, 255), "BluePortal")
        portal = blue
    else
        if orange then orange:Destroy() end
        orange = makePortal(Color3.fromRGB(255, 130, 0), "OrangePortal")
        portal = orange
    end

    local upVector = Vector3.yAxis
    if math.abs(normal.Y) > 0.9 then
        upVector = Vector3.zAxis
    end

    local center = pos + normal * 0.3
    portal.CFrame = CFrame.lookAt(center, center + normal, upVector)
    portal.Parent = workspace
end

local function teleport(to)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local look = to.CFrame.LookVector
    local exitPos = to.Position + look * EXIT_OFFSET

    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.1 then
        local cl = hrp.CFrame.LookVector
        flat = Vector3.new(cl.X, 0, cl.Z)
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(exitPos, exitPos + flat.Unit)
    armed = false
end

RunService.Heartbeat:Connect(function()
    if not blue or not orange then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dBlue = (hrp.Position - blue.Position).Magnitude
    local dOrange = (hrp.Position - orange.Position).Magnitude

    if not armed then
        if dBlue > REARM_RADIUS and dOrange > REARM_RADIUS then
            armed = true
        end
        return
    end

    if dBlue < ENTER_RADIUS then
        teleport(orange)
    elseif dOrange < ENTER_RADIUS then
        teleport(blue)
    end
end)

local tool = Instance.new("Tool")
tool.Name = "Портал пушка"
tool.ToolTip = "Нажми куда угодно"
tool.RequiresHandle = false
tool.CanBeDropped = false

tool.Activated:Connect(function()
    placePortal(nextBlue)
    nextBlue = not nextBlue
end)

local function giveTool()
    local backpack = player:WaitForChild("Backpack")
    if tool.Parent ~= backpack and tool.Parent ~= player.Character then
        tool.Parent = backpack
    end
end

giveTool()
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    giveTool()
end)
